# ==============================================================
# AI RESUME & INTERVIEW PREP - ENVIRONMENT CONFIGURATION
# ==============================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database (MongoDB Connection String)
# Example Local: mongodb://127.0.0.1:27017/ai-resume
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_resume?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri_here

# 3. JSON Web Token (JWT) Secret
# Use any strong random secret string (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 4. Groq AI API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Recommended: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Frontend Client URL (For CORS setup)
CLIENT_URL=http://localhost:5173
